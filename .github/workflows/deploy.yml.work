name: CI/CD (self-hosted)

on:
  push:
    branches: ["main"]

env:
  DOCKER_USER: ${{ secrets.DOCKER_USERNAME }}
  TAG: 1.0.${{ github.run_number }}

jobs:

  build-deploy:
    runs-on: self-hosted

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      # ======================
      # Docker login
      # ======================
      - name: Docker login
        run: echo "${{ secrets.DOCKER_PASSWORD }}" | docker login -u "${{ secrets.DOCKER_USERNAME }}" --password-stdin

      # ======================
      # Build backend
      # ======================
      - name: Build backend
        run: |
          docker build -t $DOCKER_USER/backend:$TAG apps/backend
          docker push $DOCKER_USER/backend:$TAG

      # ======================
      # Build frontend
      # ======================
      - name: Build frontend
        run: |
          docker build -t $DOCKER_USER/frontend:$TAG apps/frontend
          docker push $DOCKER_USER/frontend:$TAG

      # ======================
      # Deploy to K3s
      # ======================
      - name: Deploy to K3s
        run: |
          kubectl set image deployment/backend backend=$DOCKER_USER/backend:$TAG -n devops-app
          kubectl set image deployment/frontend frontend=$DOCKER_USER/frontend:$TAG -n devops-app

          kubectl rollout status deployment/backend -n devops-app
          kubectl rollout status deployment/frontend -n devops-app
